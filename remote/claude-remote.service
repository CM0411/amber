[Unit]
Description=Amber — Claude Code Remote Control (mobiele app, Z490)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arch
WorkingDirectory=/home/arch/amber
Environment=HOME=/home/arch
Environment=PATH=/home/arch/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/arch/amber-werk/remote/start.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
