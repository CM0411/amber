[Unit]
Description=Amber — de kijker die haar brein doormeet voor het venster (Z490, CPU)
After=network-online.target

[Service]
Type=simple
User=arch
# alleen de CPU: de kaart is van de training; en zachtjes, zodat de
# leerlus nooit op de kijker wacht (roadmap fase 2)
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=4
Environment=AMBER_KIJKER_LOKAAL=1
# 24 aug 2026 (op de Z490 als drop-in rust.conf): de kijker kostte de training 13%.
# Cleys keuze: alleen tussen 17:00 en 23:00 (UREN), dan elke 30 s een ronde (RUST);
# SLAAP_NA=300: ook buiten de uren wakker zolang Cley iets doet in het venster (/ik-kijk);
# een open tabblad zonder hem telt niet. Live: elke doorgang naar rapport/live.json.
Environment=AMBER_KIJKER_RUST=5
Environment=AMBER_KIJKER_SLAAP_NA=300
Environment=AMBER_KIJKER_UREN=17-23
Nice=10
WorkingDirectory=/home/arch/amber-werk
ExecStart=/usr/bin/python3 -u /home/arch/amber-werk/brein/kijker.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
